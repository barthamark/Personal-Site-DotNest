<!DOCTYPE html>
<html lang="{{ Culture.Name }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{{ "PageTitle" | shape_new | shape_stringify }}</title>

    {% resources type: "Meta" %}

    {% link type:"image/png", rel: "icon", href: "~/mediatheme/favicon/favicon-96x96.png" %}
    {% link type:"image/svg+xml", rel: "icon", href: "~/mediatheme/favicon/favicon.svg" %}
    {% link type:"image/x-icon", rel: "shortcut icon", href: "~/mediatheme/favicon/favicon.ico" %}
    {% link type:"image/png", rel: "apple-touch-icon", href: "~/mediatheme/favicon/apple-touch-icon.png" %}
    {% link rel:"manifest", href: "~/mediatheme/favicon/site.webmanifest" %}

    {% style name: "personal-site", src: "~/mediatheme/css/site.css" %}

    {% resources type: "HeadScript" %}
    {% resources type: "HeadLink" %}
    {% resources type: "Stylesheet" %}
    {% render_section "HeadMeta", required: false %}
</head>
<body id="page-top" dir="{{ Culture.Dir }}">
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 transition-colors">
    <header class="w-full bg-white dark:bg-gray-800 shadow-sm sticky top-0 z-10 transition-colors">
        {% assign headerMenu = Content["alias:header-menu"] %}
        {% assign menuItems = headerMenu.Content.MenuItemsListPart.MenuItems %}

        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center">
                <h1 class="text-xl font-bold text-gray-800 dark:text-gray-200">
                    Márk Bartha
                </h1>
            </div>
            <div class="flex items-center gap-4">
                <button
                    class="p-2 text-gray-600 dark:text-gray-300 hover:text-purple-600 dark:hover:text-purple-400 transition-colors"
                    aria-label="Toggle theme"
                >
                    <i class="icon-moon"></i>
                </button>
                <button
                    id="menu-toggle"
                    class="md:hidden p-2 text-gray-600 dark:text-gray-300"
                    aria-label="Open menu"
                >
                    <i class="icon-menu"></i>
                </button>
            </div>
            <nav class="hidden md:flex space-x-8">
                {% for item in menuItems %}
                    <a href="{{ item.LinkMenuItemPart.Url | href }}"
                       class="text-gray-600 dark:text-gray-300 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
                        {{ item.DisplayText }}
                    </a>
                {% endfor %}
            </nav>
        </div>

        <div id="mobile-menu" class="hidden md:hidden bg-white dark:bg-gray-800 shadow-lg absolute w-full">
            <nav class="flex flex-col p-4">
                {% for item in menuItems %}
                    <a href="{{ item.LinkMenuItemPart.Url | href }}"
                       class="py-2 px-4 text-gray-700 dark:text-gray-300 hover:bg-purple-50 dark:hover:bg-gray-700 rounded transition-colors">
                        {{ item.DisplayText }}
                    </a>
                {% endfor %}
            </nav>
        </div>
    </header>


    <main class="w-full">
        {% render_section "Messages", required: false %}
        {% render_section "BeforeContent", required: false %}

        {% if Request.Path == "/" %}
            <section
                id="about"
                class="w-full bg-white dark:bg-gray-800 py-20 transition-colors"
            >
                <div class="container mx-auto px-4">
                    <div class="flex flex-col md:flex-row items-center gap-12 max-w-4xl mx-auto">
                        <div
                            class="w-40 h-40 md:w-48 md:h-48 flex-shrink-0 transition-transform hover:scale-105 duration-300">
                            <img
                                src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80"
                                alt="John Developer"
                                class="w-full h-full object-cover rounded-full border-4 border-white dark:border-gray-700 shadow-lg"
                            />
                        </div>
                        <div class="text-center md:text-left space-y-6">
                            <div class="space-y-3">
                                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100">
                                    Hi, I'm John Developer
                                </h2>
                                <p class="text-xl text-gray-600 dark:text-gray-300">
                                    Helping teams build scalable apps with Orchard Core and Blazor.
                                </p>
                                <p class="text-base text-gray-500 dark:text-gray-400">
                                    Freelance .NET Developer · Consultant · Maker of Forespend
                                </p>
                                <p class="text-sm text-purple-600 dark:text-purple-400 font-medium">
                                    🚀 Currently building Forespend – a financial planning tool using Blazor Hybrid +
                                    Orchard Core.
                                </p>
                            </div>

                            <div class="flex flex-wrap gap-3 justify-center md:justify-start">
                                <span
                                    class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-lg text-base font-medium transition-transform hover:scale-105">Orchard Core</span>
                                <span
                                    class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-lg text-base font-medium transition-transform hover:scale-105">Blazor</span>
                                <span
                                    class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-lg text-base font-medium transition-transform hover:scale-105">.NET</span>
                            </div>

                            <div class="flex gap-6 justify-center md:justify-start items-center">
                                <a
                                    href="https://github.com"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="p-3 bg-gray-100 dark:bg-gray-700 rounded-full text-gray-600 dark:text-gray-300 hover:text-purple-600 dark:hover:text-purple-400 transition-all hover:scale-110"
                                    aria-label="GitHub"
                                >
                                    <i class="icon-github"></i>
                                </a>
                                <a
                                    href="https://linkedin.com"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="p-3 bg-gray-100 dark:bg-gray-700 rounded-full text-gray-600 dark:text-gray-300 hover:text-purple-600 dark:hover:text-purple-400 transition-all hover:scale-110"
                                    aria-label="LinkedIn"
                                >
                                    <i class="icon-linkedin"></i>
                                </a>
                                <a
                                    href="mailto:john@example.com"
                                    class="p-3 bg-gray-100 dark:bg-gray-700 rounded-full text-gray-600 dark:text-gray-300 hover:text-purple-600 dark:hover:text-purple-400 transition-all hover:scale-110"
                                    aria-label="Email"
                                >
                                    <i class="icon-mail"></i>
                                </a>
                                <a
                                    href="https://linkedin.com/in/johndeveloper"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-lg text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 transition-colors font-medium"
                                >
                                    View my full experience on LinkedIn →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section
                id="blog"
                class="w-full bg-white dark:bg-gray-800 py-20 transition-colors"
            >
                <div class="container mx-auto px-4 md:px-6">
                    <div class="text-center mb-16 space-y-4">
                        <h2 class="text-4xl font-bold text-gray-900 dark:text-gray-100">
                            Latest from the Blog
                        </h2>
                        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
                            Technical insights, tutorials, and thoughts on software development,
                            with a focus on .NET technologies.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {% assign recentBlogPosts = Queries.RecentBlogPosts | query %}
                        {% for item in recentBlogPosts %}
                            {{ item | shape_build_display: "Summary" | shape_render }}
                        {% endfor %}
                    </div>

                    <div class="text-center mt-16">
                        <a
                            href="/blog"
                            class="inline-flex px-8 py-4 text-lg bg-gray-900 dark:bg-gray-700 text-white rounded-lg hover:bg-gray-800 dark:hover:bg-gray-600 transition-all transform hover:scale-105 font-medium"
                        >
                            View All Posts
                        </a>
                    </div>
                </div>
            </section>
        {% endif %}

        {% render_section "Content" %}
        {% render_section "AfterContent", required: false %}

        <section
            id="connect"
            class="w-full bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-800 py-24 transition-colors"
        >
            <div class="container mx-auto px-4 md:px-6">
                <div class="text-center mb-16 space-y-4">
                    <h2 class="text-4xl font-bold text-gray-900 dark:text-gray-100">
                        Connect With Me
                    </h2>
                    <p class="text-xl text-gray-600 dark:text-gray-300">
                        Find me on these platforms.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
                    <!-- GitHub -->
                    <a
                        href="https://github.com/johndeveloper"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center p-6 bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md hover:bg-purple-50/30 dark:hover:bg-gray-700/50 transition-all transform hover:scale-105 border border-gray-100 dark:border-gray-700"
                    >
                        <div class="p-4 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-xl mr-5">
                            <i class="icon-github text-xl"></i>
                        </div>
                        <div class="space-y-1">
                            <h3 class="text-xl font-medium text-gray-900 dark:text-gray-100">GitHub</h3>
                            <p class="text-base text-gray-500 dark:text-gray-400">@johndeveloper</p>
                        </div>
                    </a>

                    <!-- LinkedIn -->
                    <a
                        href="https://linkedin.com/in/johndeveloper"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center p-6 bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md hover:bg-purple-50/30 dark:hover:bg-gray-700/50 transition-all transform hover:scale-105 border border-gray-100 dark:border-gray-700"
                    >
                        <div class="p-4 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-xl mr-5">
                            <i class="icon-linkedin text-xl"></i>
                        </div>
                        <div class="space-y-1">
                            <h3 class="text-xl font-medium text-gray-900 dark:text-gray-100">LinkedIn</h3>
                            <p class="text-base text-gray-500 dark:text-gray-400">John Developer</p>
                        </div>
                    </a>
                </div>

                <div class="mt-20 bg-white dark:bg-gray-800 p-10 rounded-xl shadow-md max-w-2xl mx-auto border border-gray-100 dark:border-gray-700">
                    <h3 class="text-3xl font-bold mb-6 text-center text-gray-900 dark:text-gray-100">
                        Let's Work Together
                    </h3>
                    <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 text-center">
                        Need help with Blazor or Orchard Core? Let's talk.
                    </p>
                    <div class="flex justify-center">
                        <a
                            href="mailto:john@example.com"
                            class="px-8 py-4 text-lg bg-gray-900 dark:bg-gray-700 text-white rounded-lg hover:bg-gray-800 dark:hover:bg-gray-600 transition-all transform hover:scale-105 font-medium"
                        >
                            Email Me
                        </a>
                    </div>
                </div>
            </div>
        </section>


    </main>

    <footer class="w-full bg-gray-800 text-gray-300 py-8">
        {% render_section "Footer", required: false %}
        <div class="container mx-auto px-4 md:px-6">
            <div class="flex flex-col space-y-6">
                <!-- Main footer content -->
                <div class="flex flex-col md:flex-row justify-center items-center space-y-4 md:space-y-0">
                    <div class="flex flex-wrap items-center justify-center gap-2 md:gap-3 text-sm text-center">
                        <span>Built by John Developer</span>
                        <span class="hidden md:inline">·</span>
                        <span>Orchard Core & Blazor Specialist</span>
                        <span class="hidden md:inline">·</span>
                        <span>&copy; {{ "now" | local | date: "%Y" }} John Developer</span>
                        <span class="hidden md:inline">—</span>
                        <a
                            href="#connect"
                            class="text-purple-400 hover:text-purple-300 transition-colors"
                        >
                            Let's work together
                        </a>
                        <span class="hidden md:inline">·</span>
                        <a
                            href="/rss.xml"
                            class="inline-flex items-center text-purple-400 hover:text-purple-300 transition-colors"
                        >
                            <i class="icon-rss mr-1"></i>
                            RSS Feed
                        </a>
                    </div>
                </div>

                <!-- DotNest information -->
                <div class="text-sm text-gray-400 text-center border-t border-gray-700 pt-6">
                    <p class="max-w-3xl mx-auto">
                        Powered by
                        <a
                            href="https://dotnest.com"
                            class="text-purple-400 hover:text-purple-300 transition-colors"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            DotNest
                        </a>,
                        the Orchard Core SaaS platform fueled by
                        <a
                            href="https://lombiq.com"
                            class="text-purple-400 hover:text-purple-300 transition-colors"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Lombiq
                        </a>.
                        See
                        <a
                            href="https://lombiq.com/privacy-policy"
                            class="text-purple-400 hover:text-purple-300 transition-colors"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Lombiq's privacy policy
                        </a>
                        approved by the site's operator.
                    </p>
                </div>
            </div>
        </div>
    </footer>


    {% resources type: "FootScript" %}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggle = document.getElementById('menu-toggle');
            const mobileMenu = document.getElementById('mobile-menu');

            toggle.addEventListener('click', function () {
                const icon = this.querySelector('i');
                const isOpen = mobileMenu.classList.contains('block');

                if (isOpen) {
                    mobileMenu.classList.remove('block');
                    mobileMenu.classList.add('hidden');
                    icon.classList.remove('icon-x');
                    icon.classList.add('icon-menu');
                } else {
                    mobileMenu.classList.remove('hidden');
                    mobileMenu.classList.add('block');
                    icon.classList.remove('icon-menu');
                    icon.classList.add('icon-x');
                }
            });
        });
    </script>
</div>
</body>
</html>
