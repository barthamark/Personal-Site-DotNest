{% assign header_items = Model.ContentItem.Content.Header.ContentItems %}
{% assign stats = Model.ContentItem.Content.Stats.ContentItems %}
{% assign testimonials = Model.ContentItem.Content.Testimonials.ContentItems %}

<section class="w-full py-24">
    <div class="page-container">
        {% if header_items %}
            <div class="text-center mb-16">
                {% for item in header_items %}
                    {{ item | shape_build_display: "Detail" | shape_render }}
                {% endfor %}
            </div>
        {% endif %}

        {% if stats %}
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-20 border-b border-light-blue/20 theme-dark-blue:border-white/10 theme-dark-panel:border-white/10 theme-light-gray:border-gray-200 pb-12">
                {% for item in stats %}
                    {{ item | shape_build_display: "Detail" | shape_render }}
                {% endfor %}
            </div>
        {% endif %}

        {% if testimonials %}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {% for item in testimonials %}
                    {{ item | shape_build_display: "Detail" | shape_render }}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
