{% assign content_item = Model.ContentItem %}
{% assign blog_post = content_item.Content.BlogPost %}
{% assign title = content_item.DisplayText %}
{% assign excerpt = blog_post.Excerpt.Text %}
{% assign read_time = blog_post.ReadTime.Text %}
{% assign published_date = content_item.PublishedUtc | default: content_item.CreatedUtc %}
{% assign tag_terms = blog_post.Tags | taxonomy_terms %}
{% assign blog_container = content_item | container %}
{% assign back_url = "/blog" %}
{% if blog_container %}
    {% assign back_url = blog_container | display_url %}
{% endif %}

<section class="pt-32 pb-12" data-theme="dark-blue">
    <div class="page-container max-w-3xl">
        <a href="{{ back_url }}" class="inline-flex items-center text-light-blue hover:text-white transition-colors mb-8 text-sm font-medium">
            <i data-lucide="arrow-left" class="w-4 h-4 mr-2" aria-hidden="true"></i>
            {{ "Back to Blog" | t }}
        </a>

        {% if tag_terms and tag_terms.size > 0 %}
            <div class="mb-6 flex flex-wrap gap-2">
                {% for term in tag_terms %}
                    <span class="tag">
                        {{ term.DisplayText }}
                    </span>
                {% endfor %}
            </div>
        {% endif %}

        {% if title != blank %}
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight text-balance">
                {{ title }}
            </h1>
        {% endif %}

        {% if content_item.Author or published_date or read_time != blank %}
            <div class="flex flex-wrap items-center gap-6 text-sm text-light-text/60 font-mono">
                {% if content_item.Author %}
                    <div class="flex items-center">
                        <i data-lucide="user" class="w-4 h-4 mr-2" aria-hidden="true"></i>
                        Márk Bartha
                    </div>
                {% endif %}
                {% if published_date %}
                    <div class="flex items-center">
                        <i data-lucide="calendar" class="w-4 h-4 mr-2" aria-hidden="true"></i>
                        {{ published_date | local | date: "%b %d, %Y" }}
                    </div>
                {% endif %}
                {% if read_time != blank %}
                    <div class="flex items-center">
                        <i data-lucide="clock" class="w-4 h-4 mr-2" aria-hidden="true"></i>
                        {{ read_time }}
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
</section>

<section class="bg-white" data-theme="white">
    <article class="page-container max-w-3xl py-16">
        {% if excerpt != blank %}
            <p class="text-xl leading-relaxed text-gray-600 mb-12 font-medium text-pretty">
                {{ excerpt }}
            </p>
        {% endif %}

        {% assign body_markdown = content_item.Content.MarkdownBodyPart.Markdown %}
        {% if body_markdown != blank %}
            <div class="rich-text text-dark-blue text-pretty">
                {{ body_markdown | markdownify | shortcode | raw }}
            </div>
        {% endif %}
    </article>
</section>
