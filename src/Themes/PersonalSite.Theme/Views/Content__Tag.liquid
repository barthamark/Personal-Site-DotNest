{% assign content_item = Model.ContentItem %}
{% assign title = content_item.DisplayText %}

<section class="hero-backdrop w-full pt-32 pb-20" data-theme="dark-blue">
    <div class="page-container relative z-10">
        <div class="max-w-3xl">
            <span class="pill mb-6">{{ "Tag" | t }}</span>

            {% if title != blank %}
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-hero mb-6 tracking-tight text-balance">
                    {{ title }}
                </h1>
            {% endif %}
        </div>
    </div>
</section>

{% shape_remove_item Model.Content "TitlePart" %}
{{ Model.Content | shape_render }}
