{% assign widgets = Model.ContentItem.Content.BagPart.ContentItems %}
{% assign image_paths = Model.ContentItem.Content.Hero.Image.Paths %}
{% assign image_texts = Model.ContentItem.Content.Hero.Image.MediaTexts %}
{% assign image_path = image_paths | first %}
{% assign image_text = image_texts | first %}
{% assign background_label = Model.ContentItem.Content.Hero.BackgroundLabel.Text %}
{% assign background_items = Model.ContentItem.Content.Background.ContentItems %}

<section class="hero-backdrop w-full pt-32 pb-20 lg:pt-40 lg:pb-32">
    <div class="page-container relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-7">
                {% if widgets or background_items %}
                    <div class="flex flex-col gap-8">
                        {% for widget in widgets %}
                            {{ widget | shape_build_display: "Detail" | shape_render }}
                        {% endfor %}

                        {% if background_items %}
                            <div class="border-t border-white/10 pt-6">
                                {% if background_label != blank %}
                                    <p class="text-sm font-mono text-light-text/60 mb-4 uppercase tracking-wider">
                                        {{ background_label }}
                                    </p>
                                {% endif %}
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    {% for item in background_items %}
                                        {% assign item_icon = item.IconText.Icon.Text %}
                                        {% assign item_text = item.IconText.Text.Text %}
                                        {% if item_text != blank %}
                                            <div class="flex items-center gap-2">
                                                {% if item_icon != blank %}
                                                    <i data-lucide="{{ item_icon }}" class="w-4 h-4 text-light-blue flex-shrink-0" aria-hidden="true"></i>
                                                {% endif %}
                                                <span class="text-sm text-light-text/70">
                                                    {{ item_text }}
                                                </span>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            <div class="lg:col-span-5 relative">
                <div class="relative max-w-md mx-auto lg:mx-0">
                    <div class="absolute -top-4 -right-6 w-full h-full border-2 border-light-blue/20 rounded-2xl z-0 hidden md:block"></div>
                    <div class="absolute -bottom-4 -left-4 w-24 h-24 bg-light-blue/10 rounded-full blur-2xl z-0"></div>

                    <div class="relative z-10 w-full rounded-2xl overflow-hidden shadow-2xl border border-white/10 bg-dark-panel aspect-4-5 md:aspect-square lg:aspect-4-5">
                        <div class="absolute inset-0 bg-linear-to-t from-dark-blue/80 via-transparent to-transparent z-20 opacity-60"></div>
                        {% if image_path %}
                            <img
                                src="{{ image_path | asset_url }}"
                                alt="{{ image_text }}"
                                class="w-full h-full object-cover object-center transform hover:scale-105 transition-transform duration-700 ease-out"
                            >
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
