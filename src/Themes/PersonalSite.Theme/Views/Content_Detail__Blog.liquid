<section class="w-full bg-white dark:bg-gray-800 py-16 md:py-24 transition-colors">
    <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-12">
            <h1 class="text-3xl font-bold mb-4 text-gray-900 dark:text-gray-100">
                Blog Posts
            </h1>
            <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
                Technical insights, tutorials, and experiments in .NET technologies.
            </p>
        </div>

        {% shape_remove_item Model.Content "HtmlBodyPart" %}
        {% shape_remove_item Model.Content "Blog-Image" %}

        {{ Model.Content | shape_render }}
    </div>
</section>
