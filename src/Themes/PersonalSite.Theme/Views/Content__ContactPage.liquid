{% assign hero_items = Model.ContentItem.Content.Hero.ContentItems %}
{% assign after_items = Model.ContentItem.Content.After.ContentItems %}
{% assign form_items = Model.ContentItem.Content.Form.ContentItems %}
{% assign form_settings = Model.ContentItem.Content.ContactForm %}
{% assign privacy_markdown = form_settings.PrivacyText.Markdown | default: "I respect your privacy. No spam, ever." %}

<div data-theme="light-gray">
    {% if hero_items %}
        <div data-theme="dark-blue">
            <section class="hero-backdrop w-full pt-32 pb-32 text-center">
                <div class="page-container max-w-4xl relative z-10">
                    <div class="flex flex-col items-center gap-6 text-center">
                        {% for widget in hero_items %}
                            <div class="w-full text-center">
                                {{ widget | shape_build_display: "Detail" | shape_render }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </section>
        </div>
    {% endif %}

    <section class="px-4 pb-24 -mt-20 relative z-20">
        <div class="max-w-2xl mx-auto">
            <div class="card shadow-lg p-8 md:p-12">
                {% if form_items %}
                    {% for item in form_items %}
                        {{ item | shape_build_display: "Detail" | shape_render }}
                    {% endfor %}
                {% endif %}

                {% if privacy_markdown != blank %}
                    <div class="text-xs text-center text-gray-500 mt-4">
                        {{ privacy_markdown | markdownify | shortcode | raw }}
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    {% if after_items %}
        {% for item in after_items %}
            {% assign theme_value = item.BlockCommon.Theme.Text %}
            {% assign theme_key = "dark-blue" %}
            {% case theme_value %}
                {% when "DarkPanel" %}
                    {% assign theme_key = "dark-panel" %}
                {% when "LightGray" %}
                    {% assign theme_key = "light-gray" %}
                {% when "White" %}
                    {% assign theme_key = "white" %}
            {% endcase %}

            <div data-theme="{{ theme_key }}">
                {{ item | shape_build_display: "Detail" | shape_render }}
            </div>
        {% endfor %}
    {% endif %}
</div>
