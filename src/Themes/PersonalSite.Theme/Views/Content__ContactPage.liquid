{% assign hero_items = Model.ContentItem.Content.Hero.ContentItems %}
{% assign after_items = Model.ContentItem.Content.After.ContentItems %}
{% assign form_settings = Model.ContentItem.Content.ContactForm %}
{% assign post_url = form_settings.PostUrl.Text %}
{% assign submit_text = form_settings.SubmitText.Text | default: "Send Message" %}
{% assign privacy_html = form_settings.PrivacyText.Html | default: "I respect your privacy. No spam, ever." %}

<div data-theme="light-gray">
    {% if hero_items %}
        <div data-theme="dark-blue">
            <section class="hero-backdrop w-full pt-32 pb-32 text-center">
                <div class="page-container max-w-4xl relative z-10">
                    <div class="flex flex-col items-center gap-6 text-center">
                        {% for widget in hero_items %}
                            <div class="w-full text-center">
                                {{ widget | shape_build_display: "Detail" | shape_render }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </section>
        </div>
    {% endif %}

    <section class="px-4 pb-24 -mt-20 relative z-20">
        <div class="max-w-2xl mx-auto">
            <div class="card shadow-lg p-8 md:p-12">
                <form method="post" class="space-y-6"{% if post_url != blank %} action="{{ post_url }}"{% endif %}>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label for="name" class="block text-sm font-medium text-dark-blue">
                            {{ "Name" | t }} <span class="text-red-500">*</span>
                        </label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            required
                            class="form-field"
                            placeholder="{{ "John Doe" | t }}"
                        >
                    </div>

                    <div class="space-y-2">
                        <label for="email" class="block text-sm font-medium text-dark-blue">
                            {{ "Work Email" | t }} <span class="text-red-500">*</span>
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            class="form-field"
                            placeholder="{{ "john@company.com" | t }}"
                        >
                    </div>
                </div>

                <div class="space-y-2">
                    <label for="company" class="block text-sm font-medium text-dark-blue">
                        {{ "Company" | t }} <span class="text-red-500">*</span>
                    </label>
                    <input
                        type="text"
                        id="company"
                        name="company"
                        required
                        class="form-field"
                        placeholder="{{ "Company Name Ltd." | t }}"
                    >
                </div>

                <div class="space-y-2">
                    <label for="interest" class="block text-sm font-medium text-dark-blue">
                        {{ "What are you looking for?" | t }}
                    </label>
                    <div class="relative">
                        <select id="interest" name="interest" class="form-field appearance-none bg-white">
                            <option value="" selected disabled>{{ "Select an option" | t }}</option>
                            <option value="website">{{ "Website Rebuild" | t }}</option>
                            <option value="knowledge-hub">{{ "Knowledge Hub / Help Center" | t }}</option>
                            <option value="roadmap">{{ "Content Architecture and Roadmap" | t }}</option>
                            <option value="other">{{ "Other" | t }}</option>
                        </select>
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none">
                            <i data-lucide="chevron-down" class="w-4 h-4 text-gray-500" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>

                <div class="space-y-2">
                    <label for="message" class="block text-sm font-medium text-dark-blue">
                        {{ "Message" | t }} <span class="text-red-500">*</span>
                    </label>
                    <textarea
                        id="message"
                        name="message"
                        required
                        rows="5"
                        class="form-field resize-none"
                        placeholder="{{ "Tell me about your project goals and timeline..." | t }}"
                    ></textarea>
                </div>

                <div class="pt-2">
                    <button type="submit" class="btn btn-primary btn-md w-full justify-center">
                        {{ submit_text }}
                    </button>
                </div>

                {% if privacy_html != blank %}
                    <div class="text-xs text-center text-gray-500 mt-4">
                        {{ privacy_html | raw }}
                    </div>
                {% endif %}
                </form>
            </div>
        </div>
    </section>

    {% if after_items %}
        {% for item in after_items %}
            {% assign theme_value = item.BlockCommon.Theme.Text %}
            {% assign theme_key = "dark-blue" %}
            {% case theme_value %}
                {% when "DarkPanel" %}
                    {% assign theme_key = "dark-panel" %}
                {% when "LightGray" %}
                    {% assign theme_key = "light-gray" %}
                {% when "White" %}
                    {% assign theme_key = "white" %}
            {% endcase %}

            <div data-theme="{{ theme_key }}">
                {{ item | shape_build_display: "Detail" | shape_render }}
            </div>
        {% endfor %}
    {% endif %}
</div>
