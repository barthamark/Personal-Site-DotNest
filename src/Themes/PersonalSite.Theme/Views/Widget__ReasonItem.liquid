{% assign icon = Model.ContentItem.Content.ReasonItem.Icon.Text %}
{% assign title = Model.ContentItem.Content.ReasonItem.Title.Text %}
{% assign body = Model.ContentItem.Content.ReasonItem.Body.Html %}

<div class="flex gap-4">
    <div class="flex-shrink-0">
        {% if icon != blank %}
            <i data-lucide="{{ icon }}" class="w-6 h-6 text-light-blue" aria-hidden="true"></i>
        {% endif %}
    </div>
    <div>
        {% if title != blank %}
            <h3 class="text-lg font-bold mb-2 theme-dark-blue:text-white theme-dark-panel:text-white theme-light-gray:text-dark-blue theme-white:text-dark-blue">
                {{ title }}
            </h3>
        {% endif %}
        {% if body != blank %}
            <div class="rich-text text-sm theme-dark-blue:text-light-text/70 theme-dark-panel:text-light-text/70 theme-light-gray:text-dark-blue/70 theme-white:text-dark-blue/70">
                {{ body | raw }}
            </div>
        {% endif %}
    </div>
</div>
