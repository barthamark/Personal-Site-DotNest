{% assign quote_markdown = Model.ContentItem.Content.Testimonial.Quote.Markdown %}
{% assign name = Model.ContentItem.Content.Testimonial.Name.Text %}
{% assign role = Model.ContentItem.Content.Testimonial.Role.Text %}
{% assign company = Model.ContentItem.Content.Testimonial.Company.Text %}
{% assign widget_classes = Model.Classes | join: " " | strip %}

<div class="card p-8{% if widget_classes != blank %} {{ widget_classes }}{% endif %}">
    <i data-lucide="quote" class="w-8 h-8 text-light-blue/20 mb-4" aria-hidden="true"></i>

    {% if quote_markdown != blank %}
        <div class="rich-text text-base italic theme-dark-blue:text-light-text/90 theme-dark-panel:text-light-text/90 theme-light-gray:text-dark-blue/80 theme-white:text-dark-blue/80 mb-6">
            {{ quote_markdown | markdownify | shortcode | raw }}
        </div>
    {% endif %}

    <div class="border-t border-gray-100 theme-dark-blue:border-white/10 theme-dark-panel:border-white/10 pt-4">
        {% if name != blank %}
            <div class="font-bold theme-dark-blue:text-white theme-dark-panel:text-white theme-light-gray:text-dark-blue theme-white:text-dark-blue">{{ name }}</div>
        {% endif %}
        {% if role != blank or company != blank %}
            <div class="text-sm theme-dark-blue:text-light-text/60 theme-dark-panel:text-light-text/60 theme-light-gray:text-dark-blue/60 theme-white:text-dark-blue/60">
                {% if role != blank %}{{ role }}{% endif %}{% if role != blank and company != blank %}, {% endif %}{% if company != blank %}{{ company }}{% endif %}
            </div>
        {% endif %}
    </div>
</div>
