{% assign content_item = Model.ContentItem %}
{% assign blog_post = content_item.Content.BlogPost %}
{% assign title = content_item.DisplayText %}
{% assign excerpt = blog_post.Excerpt.Text %}
{% assign read_time = blog_post.ReadTime.Text %}
{% assign image_path = "" %}
{% if blog_post.Image and blog_post.Image.Paths %}
    {% assign image_path = blog_post.Image.Paths[0] %}
{% endif %}
{% assign tag_terms = blog_post.Tags | taxonomy_terms %}
{% assign published_date = content_item.PublishedUtc | default: content_item.CreatedUtc %}
{% assign blog_context = HttpContext.Items.blog_context %}

<a href="{{ content_item | display_url }}" class="block h-full">
    <article class="card transition-shadow duration-300 hover:shadow-md overflow-hidden flex flex-col h-full group" data-blog-context="{{ blog_context }}">
        <div class="aspect-video w-full bg-gray-100 relative overflow-hidden">
            {% if image_path != blank %}
                <img src="{{ image_path | asset_url }}" alt="{{ title | escape }}" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
            {% endif %}
            <div class="absolute inset-0 bg-linear-to-br from-dark-blue/5 to-dark-blue/10 transition-transform duration-500 group-hover:scale-105"></div>
            {% if tag_terms and tag_terms.size > 0 %}
                <div class="absolute top-4 left-4 flex flex-wrap gap-2">
                    {% for term in tag_terms %}
                        <span class="tag">
                            {{ term.DisplayText }}
                        </span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="p-6 flex flex-col flex-1">
            {% if published_date or read_time != blank %}
                <div class="flex items-center text-xs text-gray-500 mb-3 space-x-4 font-mono">
                    {% if published_date %}
                        <div class="flex items-center">
                            <i data-lucide="calendar" class="w-3 h-3 mr-1.5" aria-hidden="true"></i>
                            {{ published_date | local | date: "%b %d, %Y" }}
                        </div>
                    {% endif %}
                    {% if read_time != blank %}
                        <div class="flex items-center">
                            <i data-lucide="clock" class="w-3 h-3 mr-1.5" aria-hidden="true"></i>
                            {{ read_time }}
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            {% if title != blank %}
                <h3 class="text-xl font-bold text-dark-blue mb-3 group-hover:text-light-blue transition-colors line-clamp-2">
                    {{ title }}
                </h3>
            {% endif %}

            {% if excerpt != blank %}
                <p class="text-gray-600 text-sm leading-relaxed mb-6 line-clamp-3 flex-1">
                    {{ excerpt }}
                </p>
            {% endif %}

            <div class="mt-auto pt-4 border-t border-gray-100">
                <span class="text-sm font-bold text-dark-blue group-hover:text-light-blue transition-colors flex items-center">
                    Read article
                    <i data-lucide="arrow-right" class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
                </span>
            </div>
        </div>
    </article>
</a>
