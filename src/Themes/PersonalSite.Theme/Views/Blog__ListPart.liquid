<section class="py-20" data-theme="light-gray">
    <div class="page-container">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for post in Model.ContentItems %}
                {{ post | shape_build_display: "Summary" | shape_render }}
            {% endfor %}
        </div>

        {% if Model.Pager %}
            <div class="mt-12 flex items-center justify-center">
                {% assign previousText = "Newer Posts" | t %}
                {% assign nextText = "Older Posts" | t %}
                {% assign previousClass = "btn btn-outline btn-sm" %}
                {% assign nextClass = "btn btn-outline btn-sm" %}

                {% shape_pager Model.Pager
                    previous_text: previousText,
                    next_text: nextText,
                    previous_class: previousClass,
                    next_class: nextClass
                %}
                {{ Model.Pager | shape_render }}
            </div>
        {% endif %}
    </div>
</section>
