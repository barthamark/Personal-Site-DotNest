{% assign content_items = Model.ContentItem.Content.Content.ContentItems %}

<section class="w-full py-24">
    <div class="page-container max-w-4xl text-center">
        {% if content_items %}
            <div class="space-y-4">
                {% for item in content_items %}
                    {{ item | shape_build_display: "Detail" | shape_render }}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
