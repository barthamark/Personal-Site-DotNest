{% assign hero = Model.ContentItem.Content.ContactHero %}
{% assign pill = hero.PillText.Text %}
{% assign title = hero.Title.Text %}
{% assign highlight = hero.Highlight.Text %}
{% assign suffix = hero.TitleSuffix.Text %}
{% assign body = hero.Body.Text %}

<section class="hero-backdrop w-full pt-32 pb-32 text-center">
    <div class="page-container max-w-4xl relative z-10">
        {% if pill != blank %}
            <span class="pill mb-6">{{ pill }}</span>
        {% endif %}

        {% if title != blank or highlight != blank or suffix != blank %}
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-hero text-balance">
                {% if title != blank %}
                    {{ title }}
                {% endif %}
                {% if highlight != blank %}
                    <span class="text-light-blue">{{ highlight }}</span>
                {% endif %}
                {% if suffix != blank %}
                    {{ suffix }}
                {% endif %}
            </h1>
        {% endif %}

        {% if body != blank %}
            <p class="text-lg md:text-xl text-light-text/80 max-w-2xl mx-auto leading-relaxed">
                {{ body }}
            </p>
        {% endif %}
    </div>
</section>
