{% assign question = Model.ContentItem.Content.FaqItem.Question.Text %}
{% assign answer_markdown = Model.ContentItem.Content.FaqItem.Answer.Markdown %}
{% assign widget_classes = Model.Classes | join: " " | strip %}

{% if question != blank %}
    <div class="space-y-2{% if widget_classes != blank %} {{ widget_classes }}{% endif %}">
        <h4 class="font-medium theme-dark-blue:text-white theme-dark-panel:text-white theme-light-gray:text-dark-blue theme-white:text-dark-blue">
            {{ question }}
        </h4>
        {% if answer_markdown != blank %}
            <div class="rich-text text-sm theme-dark-blue:text-light-text/70 theme-dark-panel:text-light-text/70 theme-light-gray:text-dark-blue/70 theme-white:text-dark-blue/70">
                {{ answer_markdown | markdownify | shortcode | raw }}
            </div>
        {% endif %}
    </div>
{% endif %}
