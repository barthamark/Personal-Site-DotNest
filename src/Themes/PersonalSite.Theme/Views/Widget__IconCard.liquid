{% assign icon = Model.ContentItem.Content.IconCard.Icon.Text %}
{% assign text = Model.ContentItem.Content.IconCard.Text.Text %}

<div class="flex items-start p-4 card-compact">
    {% if icon != blank %}
        <i data-lucide="{{ icon }}" class="w-6 h-6 text-red-500 mr-4 flex-shrink-0 mt-0.5" aria-hidden="true"></i>
    {% endif %}
    {% if text != blank %}
        <span class="text-lg font-medium theme-dark-blue:text-light-text theme-dark-panel:text-light-text">{{ text }}</span>
    {% endif %}
</div>
